# ──────────────────────────────────────────────
# NAKAMA — Environment Configuration Template
# ──────────────────────────────────────────────
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` to version control.

# ─── Database (Docker + Prisma) ──────────────
DB_USER=nakama_user
DB_PASSWORD=nakama_secure_pass_CHANGE_ME
DB_NAME=nakama_db
DB_PORT=5432
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT}/${DB_NAME}?schema=public"

# ─── Authentication ──────────────────────────
JWT_ACCESS_SECRET="CHANGE_ME_min_32_chars_access_secret"
JWT_REFRESH_SECRET="CHANGE_ME_min_32_chars_refresh_secret"

# ─── Client URL (CORS) ──────────────────────
CLIENT_URL="http://localhost:5173"

# ─── Server ─────────────────────────────────
PORT=5000

# ─── File Uploads ───────────────────────────
UPLOAD_PATH="uploads"
MAX_FILE_SIZE=5242880
